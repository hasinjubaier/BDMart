{
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@bdmart/config": ["packages/config"],
      "@bdmart/contracts": ["packages/contracts/src"],
      "@bdmart/contracts/*": ["packages/contracts/src/*"],
      "@bdmart/utils": ["packages/utils/src"],
      "@bdmart/utils/*": ["packages/utils/src/*"],
      "@bdmart/database": ["database/src"],
      "@bdmart/database/*": ["database/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
