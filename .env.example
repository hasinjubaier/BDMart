# ==============================================================================
# BDMart — Environment Configuration Template (.env.example)
# Copy this file to .env or .env.local and populate with your environment secrets.
# NEVER commit actual .env files containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON MANAGED POSTGRESQL (LAKEBASE)
# ------------------------------------------------------------------------------
# Pooled connection string (with "-pooler") for runtime application traffic:
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[ENDPOINT_ID]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string (WITHOUT "-pooler") for Prisma migrations and DDL:
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:[PASSWORD]@[ENDPOINT_ID].[REGION].aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. BACKEND API (NestJS 11 — apps/api)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV="development"
API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Authentication & JWT Configuration
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
OTP_HASH_SECRET="replace-with-a-secure-random-64-character-secret-for-hmac-in-production"
ADMIN_BOOTSTRAP_SECRET="replace-with-a-secure-admin-bootstrap-secret-in-production"

# ------------------------------------------------------------------------------
# 3. WEB FRONTEND (Next.js 16 — apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. MOBILE APPLICATION (React Native / Expo SDK 58 — apps/mobile)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL="http://localhost:4000/api"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 OBJECT STORAGE (Media & Document Uploads)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="bdmart-assets-dev"
CLOUDFLARE_R2_PUBLIC_URL="https://assets.bdmart.com.bd"

# ------------------------------------------------------------------------------
# 6. BANGLADESH PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
# SSLCommerz
SSLCOMMERZ_STORE_ID="bdmar_test_sandbox"
SSLCOMMERZ_STORE_PASSWORD="sandbox_password"
SSLCOMMERZ_IS_SANDBOX=true

# bKash PGW (Direct API)
BKASH_APP_KEY="bkash_test_app_key"
BKASH_APP_SECRET="bkash_test_app_secret"
BKASH_USERNAME="sandbox_tokenized_user"
BKASH_PASSWORD="sandbox_tokenized_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# Nagad PGW
NAGAD_MERCHANT_ID="NAGAD_TEST_MERCHANT"
NAGAD_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----"
NAGAD_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAz8qF...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 7. SMS GATEWAY (Bangladesh Mobile OTP Delivery)
# ------------------------------------------------------------------------------
SMS_GATEWAY_API_KEY="sandbox_sms_api_key"
SMS_GATEWAY_SENDER_ID="BDMART"
SMS_GATEWAY_ENDPOINT="https://api.sms-gateway.com.bd/v1/send"
