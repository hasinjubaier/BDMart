# ==============================================================================
# NEON POSTGRESQL CONNECTIVITY TEST CONFIGURATION
# ==============================================================================
# Copy this file to .env and insert your connection strings from the Neon Console:
# cp .env.example .env
#
# IMPORTANT SECURITY NOTES:
# - Never commit your .env file or share passwords in chat.
# - The test script will NEVER log or print your connection strings or credentials.
# ==============================================================================

# 1. Pooled Connection String (Host contains '-pooler', used for normal app queries)
POOLED_DATABASE_URL="postgresql://username:password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 2. Direct Connection String (Host does NOT contain '-pooler', used for migrations/admin)
DIRECT_DATABASE_URL="postgresql://username:password@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require"

