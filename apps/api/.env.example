# ==============================================================================
# BDMart — Backend API Environment Configuration (.env.example)
# ==============================================================================
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
OTP_HASH_SECRET="replace-with-a-secure-random-64-character-secret-for-hmac-in-production"
ADMIN_BOOTSTRAP_SECRET="replace-with-a-secure-admin-bootstrap-secret-in-production"

# Neon Managed PostgreSQL
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:[PASSWORD]@[ENDPOINT].[REGION].aws.neon.tech/neondb?channel_binding=require&sslmode=require"
